# Copy this file to .env and paste your real token there.
# .env is gitignored — never commit your token.

# Pennylane Company API token (v2)
PENNYLANE_API_TOKEN=paste-your-token-here

# Optional — override the API base URL (defaults to the value below)
# PENNYLANE_API_BASE=https://app.pennylane.com/api/external/v2
